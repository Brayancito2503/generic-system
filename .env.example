# Generic System — Plantilla de variables de entorno
# Copia este archivo a `.env` y completa con tus credenciales.

# Conexión con pooling (PgBouncer) — usada por Prisma en runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Conexión directa sin pooling — usada para migraciones ddl y tareas administrativas
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
AUTH_SECRET=genera_uno_con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
